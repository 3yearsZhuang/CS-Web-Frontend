{
  "name": "projects",
  "version": "0.9.7",
  "private": true,
  "scripts": {
    "build": "node ./tools/scripts/build-app.mjs",
    "clean": "rm -rf .build dist node_modules && pnpm install",
    "dev": "node ./tools/scripts/dev-server.mjs",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint",
    "lint:build": "eslint . --quiet",
    "start": "node ./tools/scripts/start-server.mjs",
    "tunnel": "node ./tools/scripts/cloudflare-tunnel.mjs",
    "prepare": "bash ./tools/scripts/install-deps.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "ts-check": "tsc -p tsconfig.json",
    "validate": "pnpm run --parallel '/^(ts-check|lint:build)$/'",
    "e2e": "playwright test",
    "test:e2e": "playwright test",
    "deploy:build": "docker compose -f tools/deploy/docker-compose.yml build",
    "deploy:up": "docker compose -f tools/deploy/docker-compose.yml up -d",
    "deploy:down": "docker compose -f tools/deploy/docker-compose.yml down",
    "deploy:logs": "docker compose -f tools/deploy/docker-compose.yml logs -f"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "motion": "^12.42.2",
    "next": "16.3.0",
    "next-intl": "^4.13.5",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "swr": "^2.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "only-allow": "^1.2.2",
    "postgres": "^3.4.9",
    "tailwindcss": "^4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "yaml": "1.10.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch@9": "9.0.7",
      "picomatch@2": "2.3.2",
      "picomatch@4": ">=4.0.4",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "postcss@8": ">=8.5.23",
      "esbuild": ">=0.28.1",
      "@babel/core": "7.29.6"
    }
  }
}
