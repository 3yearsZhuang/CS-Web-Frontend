{
  "name": "projects",
  "version": "0.9.1",
  "private": true,
  "scripts": {
    "build": "node ./tools/scripts/build-app.mjs",
    "dev": "node ./tools/scripts/dev-server.mjs",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint",
    "lint:build": "eslint . --quiet",
    "start": "node ./tools/scripts/start-server.mjs",
    "tunnel": "node ./tools/scripts/cloudflare-tunnel.mjs",
    "create-user": "tsx ./tools/scripts/create-user.mjs",
    "prepare": "bash ./tools/scripts/install-deps.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "ts-check": "tsc -p tsconfig.json",
    "validate": "pnpm run --parallel '/^(ts-check|lint:build)$/'",
    "seed": "tsx tools/scripts/seed-exam-data.mjs",
    "e2e": "playwright test",
    "test:e2e": "playwright test",
    "db:setup-litestream": "bash ./tools/scripts/setup-litestream.sh",
    "db:restore-drill": "bash ./tools/scripts/restore-drill.sh",
    "deploy:build": "docker compose -f tools/deploy/docker-compose.yml build",
    "deploy:up": "docker compose -f tools/deploy/docker-compose.yml up -d",
    "deploy:down": "docker compose -f tools/deploy/docker-compose.yml down",
    "deploy:logs": "docker compose -f tools/deploy/docker-compose.yml logs -f"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "motion": "^12.42.2",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.1",
    "only-allow": "^1.2.2",
    "postgres": "^3.4.9",
    "tailwindcss": "^4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "pnpm": ">=9.0.0"
  }
}
