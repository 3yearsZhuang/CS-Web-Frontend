# SQLite 数据库文件路径（可选，默认 data/app.db）
SQLITE_DB_PATH=data/app.db

# Session 密钥（HMAC 签名 session token，生产环境必须设置随机长字符串 ≥ 32 字节）
# 生成示例：openssl rand -hex 32
# 留空时开发环境使用进程级随机密钥（重启后所有 session 失效），生产环境会打印警告
AUTH_SESSION_SECRET=

# 站点 URL（用于 metadata base URL）
NEXT_PUBLIC_SITE_URL=http://localhost:2333

# 允许的请求来源白名单（逗号分隔，用于 POST 端点的 Origin/Referer 校验，防 Login CSRF）
# 开发环境默认：http://localhost:2333,http://localhost:3000
# 生产环境必须配置为实际域名，例如：https://example.com,https://www.example.com
ALLOWED_ORIGINS=http://localhost:2333,http://localhost:3000

# 是否信任反向代理头（生产环境部署在 Nginx/Caddy 后面时设为 true）
TRUST_PROXY=false

# SMTP 邮件配置（用于注册验证码发送）
# 开发环境留空时，验证码会输出到服务器控制台而非真正发送邮件
# 生产环境必须配置真实 SMTP 服务
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localhost

# 忘记密码重置后的默认密码（管理员批准后统一重置为此密码）
PASSWORD_RESET_DEFAULT=FZTBU_CS

# GitHub OAuth 配置（用于 GitHub 第三方登录）
# 在 GitHub Settings > Developer settings > OAuth Apps 中创建
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:2333/api/auth/oauth/github/callback
