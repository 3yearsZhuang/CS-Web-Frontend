# ===== BFF 运行时（前端为 BFF，业务数据/认证/邮件由后端 FastAPI 承载）=====

# BFF 转发的后端 FastAPI 地址
BACKEND_URL=http://localhost:9000

# 站点 URL（用于 metadata base URL）
NEXT_PUBLIC_SITE_URL=http://localhost:2333

# 允许的请求来源白名单（逗号分隔，用于 POST 端点的 Origin/Referer 校验，防 Login CSRF）
# 开发环境默认：http://localhost:2333,http://localhost:3000
# 生产环境必须配置为实际域名，例如：https://example.com,https://www.example.com
ALLOWED_ORIGINS=http://localhost:2333,http://localhost:3000

# 是否信任反向代理头（生产环境部署在 Nginx/Caddy 后面时设为 true）
TRUST_PROXY=false

# ===== 以下为迁移前单体遗留变量 =====
# 运行时不被任何 API 路由引用（认证/邮件/OAuth 已由后端承载），待后续清理。
# SQLITE_DB_PATH 已随 SQLite 清理（2026-08-07）移除，前端不再使用。

# Session 签名密钥（遗留 session/验证码 HMAC；生产留空会打印警告）
# 生成示例：openssl rand -hex 32
AUTH_SESSION_SECRET=

# SMTP 邮件配置（遗留，邮件现由后端 aiosmtplib 发送）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localhost

# 忘记密码重置后的默认密码（遗留，密码重置现由后端处理）
PASSWORD_RESET_DEFAULT=FZTBU_CS

# GitHub OAuth 配置（遗留，OAuth 现由后端处理）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:2333/api/auth/oauth/github/callback
