# ============ Docker 部署环境变量（前端）============
# 复制此文件为 tools/deploy/.env 并填写实际值：
#   cp .env.example .env
# 后端变量见 ../CS-Web-Backend/.env.docker.example（compose 会自动读取）

# BFF 转发目标：compose 内部网络直连后端容器（无需修改）
# 裸机部署时改为后端实际地址，如 http://192.168.1.10:9000
BACKEND_URL=http://backend:8000

# Session 签名密钥（旧模块兼容；BFF 认证走 JWT Cookie）
# 生成方式：openssl rand -hex 32
AUTH_SESSION_SECRET=

# 站点 URL（替换为你的实际域名）
# 示例：https://cs.yourdomain.com
NEXT_PUBLIC_SITE_URL=https://cs.yourdomain.com

# 允许的请求来源白名单（逗号分隔，必须与域名一致）
# 生产环境必须配置，否则登录/注册等 POST 请求会被拒绝
ALLOWED_ORIGINS=https://cs.yourdomain.com

# ---- 以下为后端 compose 变量透传（与 ../CS-Web-Backend/.env 保持一致）----
# PostgreSQL 密码（必填）
DATABASE_PASSWORD=
# JWT 签名密钥（必填，≥32 字节）
SECRET_KEY=
# TOTP 2FA 加密密钥（必填，≥32 字节）
TOTP_ENCRYPTION_KEY=
# 管理员重置密码默认值
PASSWORD_RESET_DEFAULT=
