# ============ Docker 部署环境变量 ============
# 复制此文件为 .env 并填写实际值
# cp .env.docker.example .env

# Session 签名密钥（HMAC-SHA256，必须设置随机长字符串 ≥ 32 字节）
# 生成方式：openssl rand -hex 32
AUTH_SESSION_SECRET=

# 站点 URL（替换为你的实际域名）
# 示例：https://cs.yourdomain.com
NEXT_PUBLIC_SITE_URL=https://cs.yourdomain.com

# 允许的请求来源白名单（逗号分隔，必须与域名一致）
# 生产环境必须配置，否则登录/注册等 POST 请求会被拒绝
ALLOWED_ORIGINS=https://cs.yourdomain.com
